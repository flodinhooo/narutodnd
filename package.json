{
  "name": "narutodnd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma generate --schema prisma/postgresql/schema.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "db:prepare": "node scripts/prepare-private-data.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "db:deploy:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:seed:postgres": "npm run db:generate:postgres && node --env-file=.env.vercel.local node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "^11.1.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

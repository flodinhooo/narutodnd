generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Reservoir {
  VERY_LOW
  LOW
  AVERAGE
  HIGH
  VERY_HIGH
  EXCEPTIONAL
  MONSTER
  SPECIAL
}

enum RegenRank {
  NOVICE
  TRAINED
  ADVANCED
  EXPERT
  MASTER
}

enum SkillProficiency {
  NONE
  PROFICIENT
  EXPERTISE
}

enum JutsuRank {
  E
  D
  C
  B
  A
  S
}

enum JutsuLibraryAccess {
  CLOSED
  OPEN
}
enum JutsuOrigin {
  CANON
  SHIO_HOMEBREW
  FOUNDATION
  DM_CUSTOM
}
enum JutsuPool {
  ELEMENTAL
  CANON
  FOUNDATION
  UZUMAKI
  CHARACTER_SIGNATURE
}
enum GameSessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
}
enum LocationType {
  COUNTRY
  CITY
  VILLAGE
  DISTRICT
  BUILDING
  LANDMARK
  OTHER
}

model Campaign {
  id             String            @id @default(cuid())
  name           String
  description    String            @default("")
  dmCodeHash     String            @unique
  playerCodeHash String            @unique
  dmCodeLookup   String?           @unique
  playerCodeLookup String?         @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  characters     Character[]
  sessions       CampaignAccessSession[]
  gameSessions   GameSession[]
  locations      Location[]
  jutsuLibraryAccess JutsuLibraryAccess @default(CLOSED)
  customJutsu Jutsu[]
}

model ChakraNature {
  id          String                  @id @default(cuid())
  key         String                  @unique
  displayName String
  description String
  characters  CharacterChakraNature[]
  jutsu       JutsuChakraNature[]
}

model Character {
  id                        String                   @id @default(cuid())
  campaignId                String
  campaign                  Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name                      String
  level                     Int                      @default(1)
  portraitUrl               String?
  background                String                   @default("")
  alignment                 String                   @default("")
  description               String                   @default("")
  speed                     Int                      @default(30)
  maxHp                     Int                      @default(10)
  currentHp                 Int                      @default(10)
  hitDie                    String                   @default("d10")
  hitDieAbilityBonus         String?
  hpLegacyLevel             Int?
  hpLegacyBase              Int?
  hpOverrideOffset          Int?
  hpLevels                  CharacterHpLevel[]
  acOverride                Int?
  initiativeOverride        Int?
  str                       Int                      @default(10)
  dex                       Int                      @default(10)
  con                       Int                      @default(10)
  int                       Int                      @default(10)
  wis                       Int                      @default(10)
  cha                       Int                      @default(10)
  currentChakra             Int                      @default(0)
  reservoir                 Reservoir                @default(AVERAGE)
  customReservoirMultiplier Float?
  regenRank                 RegenRank                @default(TRAINED)
  controlRank               RegenRank                @default(TRAINED)
  breakthroughPoints        Int                      @default(0)
  shortRestsSinceLongRest   Int                      @default(0)
  limitBreakUsed            Boolean                  @default(false)
  deathSaveSuccesses        Int                      @default(0)
  deathSaveFailures         Int                      @default(0)
  severelyWounded           Boolean                  @default(false)
  natureLinks               CharacterChakraNature[]
  jutsuLinks                CharacterJutsu[]
  skills                    SkillProficiencyRecord[]
  savingThrows              SavingThrowProficiency[]
  dmData                    CharacterDMData?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([campaignId])
}

model CharacterHpLevel {
  id            String    @id @default(cuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  level         Int
  hitDie        String
  rawRoll       Int
  effectiveRoll Int
  createdAt     DateTime  @default(now())

  @@unique([characterId, level])
}

model CharacterChakraNature {
  characterId     String
  chakraNatureId  String
  isPrimary       Boolean      @default(false)
  acquiredAtLevel Int          @default(1)
  source          String       @default("CHARACTER_CREATION")
  character       Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  nature          ChakraNature @relation(fields: [chakraNatureId], references: [id])

  @@id([characterId, chakraNatureId])
}

model Jutsu {
  id                    String              @id @default(cuid())
  slug                  String
  name                  String
  germanName            String?
  japaneseName          String?
  description           String
  rank                  JutsuRank
  chakraCost            Int
  range                 String
  duration              String
  actionType            String
  attackType            String?
  damageDice            String?
  damageType            String?
  saveAbility           String?
  requiresConcentration Boolean             @default(false)
  origin                JutsuOrigin         @default(SHIO_HOMEBREW)
  pool                  JutsuPool           @default(ELEMENTAL)
  campaignId            String?
  campaign              Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category              String?
  progressionType       String?
  traditionProvenance   String?
  prerequisiteText      String?
  requiredNatureKeys    String?
  natures               JutsuChakraNature[]
  characterLinks        CharacterJutsu[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  prerequisites         JutsuPrerequisite[] @relation("JutsuPrerequisites")
  unlocks               JutsuPrerequisite[] @relation("JutsuUnlocks")
  @@unique([campaignId, slug])
  @@index([origin, pool])
  @@index([campaignId])
}

model JutsuPrerequisite {
  jutsuId             String
  prerequisiteJutsuId String
  jutsu               Jutsu @relation("JutsuPrerequisites", fields: [jutsuId], references: [id], onDelete: Cascade)
  prerequisiteJutsu  Jutsu @relation("JutsuUnlocks", fields: [prerequisiteJutsuId], references: [id], onDelete: Cascade)
  @@id([jutsuId, prerequisiteJutsuId])
}

model JutsuChakraNature {
  jutsuId        String
  chakraNatureId String
  jutsu          Jutsu        @relation(fields: [jutsuId], references: [id], onDelete: Cascade)
  nature         ChakraNature @relation(fields: [chakraNatureId], references: [id], onDelete: Cascade)

  @@id([jutsuId, chakraNatureId])
}

model CharacterJutsu {
  characterId    String
  jutsuId        String
  source         String    @default("CHARACTER_CREATION")
  learnedAtLevel Int       @default(1)
  notes          String?
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jutsu          Jutsu     @relation(fields: [jutsuId], references: [id])

  @@id([characterId, jutsuId])
}

model SkillProficiencyRecord {
  characterId String
  skill       String
  proficiency SkillProficiency
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, skill])
}

model SavingThrowProficiency {
  characterId String
  ability     String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, ability])
}

model CharacterDMData {
  characterId       String    @id
  notes             String    @default("")
  secretInformation String    @default("")
  updatedAt         DateTime  @updatedAt
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CampaignAccessSession {
  id         String   @id @default(cuid())
  campaignId String
  role       String
  expiresAt  DateTime
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model GameSession {
  id String @id @default(cuid())
  campaignId String
  number Int
  title String
  summary String @default("")
  dmNotes String @default("")
  playerNotes String @default("")
  scheduledAt DateTime?
  startedAt DateTime?
  endedAt DateTime?
  status GameSessionStatus @default(PLANNED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@unique([campaignId, number])
  @@index([campaignId, status])
}

model Location {
  id String @id @default(cuid())
  campaignId String
  parentId String?
  slug String
  name String
  type LocationType @default(OTHER)
  shortDescription String @default("")
  description String @default("")
  playerVisible Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  parent Location? @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationTree")
  @@unique([campaignId, slug])
  @@index([campaignId, playerVisible])
}
